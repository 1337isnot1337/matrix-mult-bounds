    "title": "Classify quadratic biform ranks and exclude rank 13 in the 3-by-3 block",
    "user": {
      "login": "1337isnot1337",
      "id": 164028474,
      "node_id": "U_kgDOCcbgOg",
      "avatar_url": "https://avatars.githubusercontent.com/u/164028474?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/1337isnot1337",
      "html_url": "https://github.com/1337isnot1337",
      "followers_url": "https://api.github.com/users/1337isnot1337/followers",
      "following_url": "https://api.github.com/users/1337isnot1337/following{/other_user}",
      "gists_url": "https://api.github.com/users/1337isnot1337/gists{/gist_id}",
      "starred_url": "https://api.github.com/users/1337isnot1337/starred{/owner}{/repo}",
      "subscriptions_url": "https://api.github.com/users/1337isnot1337/subscriptions",
      "organizations_url": "https://api.github.com/users/1337isnot1337/orgs",
      "repos_url": "https://api.github.com/users/1337isnot1337/repos",
      "events_url": "https://api.github.com/users/1337isnot1337/events{/privacy}",
      "received_events_url": "https://api.github.com/users/1337isnot1337/received_events",
